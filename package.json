{
  "name": "model-catalog",
  "version": "1.0.0",
  "description": "Public model catalog for Swiss. One entry per model, describing **how that model should be served** — and nothing about where.",
  "homepage": "https://github.com/modelsphere/model-catalog#readme",
  "bugs": {
    "url": "https://github.com/modelsphere/model-catalog/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/modelsphere/model-catalog.git"
  },
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "test": "./hack/validate.sh",
    "validate:schema": "node hack/validate-schema.js",
    "validate:helm": "node hack/validate-helm.js",
    "helm:install": "node hack/install-helm-tools.js",
    "helm:update-crds": "node hack/update-crds.js",
    "test:helm": "node --test hack/lib/helm-validation.test.js hack/lib/crd-schema.test.js hack/validate-helm.test.js",
    "test:helm:integration": "node --test hack/validate-helm.integration.test.js",
    "test:lib": "node --test 'hack/lib/*.test.js'",
    "prepare": "husky",
    "build:site": "node hack/build-site.js"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "husky": "^9.1.7",
    "yaml": "^2.8.1"
  }
}
